# Data (downloaded/generated at runtime, never committed).
# Directory skeletons are recreated automatically by
# scripts/prepare_opus_data.py, so gitignoring the directories wholesale
# (rather than fighting negation-pattern ordering for nested .gitkeep
# files) is simplest and equally correct.
data/raw/
data/processed/

# Experiment outputs (populated at runtime) — keep only .gitkeep placeholders
experiments/**/*
!experiments/**/.gitkeep
!experiments/**/*/

# Results (generated at runtime) — keep only .gitkeep placeholders
results/**/*.csv
results/**/*.json
results/**/*.md
results/**/*.png
!results/.gitkeep
!results/en_ti/.gitkeep
!results/en_am/.gitkeep

# MT-pipeline tokenizer weight files must NEVER live in this repo (pointer
# docs only) -- these three are read read-only from amseg/ by absolute path
# (see configs/*.yaml). This does NOT apply to Tokenizers/movoc_tok_32k/,
# which is a deliberately self-contained local copy of the canonical
# constrained-BPE MoVoC-Tok checkpoints (Table 2/Table 4/reproduction use).
Tokenizers/bpe/*.json
Tokenizers/bpe/*.spm
Tokenizers/wordpiece/*.json
Tokenizers/movoc_tok/*.json
Tokenizers/movoc_tok/*.spm
!Tokenizers/**/README.md

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# venv / conda
.venv/
venv/
env/

# SLURM logs
slurm/logs/
Extrinsic_Evaluation/slurm/logs/
*.out
*.err

# OS / editor
.DS_Store
.vscode/
*.swp

# HF cache if pointed locally
.hf_cache/
