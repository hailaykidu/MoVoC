__pycache__/
*.pyc
.venv/
.DS_Store
*.log
logs/
models/bpe_merges_*.txt

# FLORES+ is distributed as a password-protected archive so it stays out
# of web crawlers and remains a clean benchmark. Regenerate with
# scripts/build_flores.py rather than re-hosting it as plain text.
data/evaluation/*/flores_*

# Local run outputs. The repository ships the code to regenerate these;
# the figures themselves are not published.
evaluation/results/
models/

# Exception: v2/audits/incidents/ holds the raw evidence behind a documented
# failed run -- tracebacks, logs and the JSON a broken configuration
# produced. It is kept deliberately, as a debugging record. These are NOT
# results and must never be read as such; see the README in each incident
# directory.
!v2/audits/incidents/**

# Reconstruction run artifacts. The pipeline and its configuration are
# tracked; checkpoints, decoded predictions and logs are regenerated by
# run_evaluation.py.
experiments/*/checkpoints/
experiments/*/predictions/
experiments/*/logs/

# Reconstructed-pipeline measurements are internal analysis, not published
# results. They are deliberately untracked so they cannot be mistaken for
# the paper's reported values; see docs/REPRODUCIBILITY.md.
experiments/*/results/
